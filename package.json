{
  "name": "@zukujs/cli",
  "version": "0.3.0",
  "description": "Local ZukuJS game-development agent with mandatory skills, OAuth accounts and one-shot publishing",
  "type": "module",
  "bin": {
    "zuku": "./index.mjs",
    "zukujs": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "commands/",
    "lib/",
    "docs/",
    "scripts/check-syntax.mjs",
    "skills/",
    "studio/",
    "scripts/platform-build/"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "node scripts/check-syntax.mjs",
    "smoke": "node index.mjs --help"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "3.1146.0",
    "@aws-sdk/client-bedrock-runtime": "3.1146.0",
    "fflate": "0.8.3",
    "google-auth-library": "11.1.0",
    "jose": "6.2.12",
    "playwright-core": "1.63.0"
  },
  "keywords": [
    "zukujs",
    "cli",
    "html5",
    "ugc",
    "zwf"
  ],
  "license": "SOL",
  "engines": {
    "node": ">=22.0.0"
  },
  "bundledDependencies": [
    "fflate",
    "jose",
    "playwright-core",
    "@aws-sdk/client-bedrock",
    "@aws-sdk/client-bedrock-runtime",
    "google-auth-library"
  ],
  "bundleDependencies": [
    "fflate",
    "jose",
    "playwright-core",
    "@aws-sdk/client-bedrock",
    "@aws-sdk/client-bedrock-runtime",
    "google-auth-library"
  ]
}
