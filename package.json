{
  "name": "@zukujs/cli",
  "version": "0.2.0",
  "description": "ZukuJS project CLI for HTML5 creation, validation, packaging and draft uploads",
  "type": "module",
  "bin": {
    "zukujs": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "commands/",
    "lib/",
    "docs/",
    "scripts/check-syntax.mjs"
